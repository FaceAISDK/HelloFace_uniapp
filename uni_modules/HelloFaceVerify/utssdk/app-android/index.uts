export const cancel: Cancel = function (options: CancelOptions) {
  const params = { faceID: '' } as UTSJSONObject
  const handle = (raw: string): void => {
    deliver(raw, 'cancel', params.getString('faceID') ?? '', options.success ?? null, options.fail ?? null, options.complete ?? null, null)
  }
  const error = validateParams('cancel', params)
