export const setFaceFeature: SetFaceFeature = function (options: SetFaceFeatureOptions) {
  const params = { faceID: options.faceID.trim() } as UTSJSONObject
  params['feature'] = options.feature
  params['featureSpaceID'] = options.featureSpaceID
  params['overwrite'] = options.overwrite ?? false
  const handle = (raw: string): void => {
    deliver(raw, 'setFaceFeature', params.getString('faceID') ?? '', options.success ?? null, options.fail ?? null, options.complete ?? null, null)
  }
  const error = validateParams('setFaceFeature', params)
