import { EnrollFace, VerifyFace, GetFaceFeature, SetFaceFeature, DeleteFace, Cancel, EnrollFaceOptions, VerifyFaceOptions, FaceIDOptions, SetFaceFeatureOptions, CancelOptions } from '../interface.uts'
import { deliver, validateParams } from '../shared.uts'
import { HelloFaceVerifyNative } from 'uts.sdk.modules.HelloFaceVerify'

export const enrollFace: EnrollFace = function (options: EnrollFaceOptions) {
  const params = { faceID: options.faceID.trim() } as UTSJSONObject
  params['overwrite'] = options.overwrite ?? false
  params['camera'] = options.camera ?? 'front'
  const handle = (raw: string): void => {
    deliver(raw, 'enrollFace', params.getString('faceID') ?? '', options.success ?? null, options.fail ?? null, options.complete ?? null, options.onProgress ?? null)
  }
  const error = validateParams('enrollFace', params)
  if (error != null) { handle(error); return }
  const context = UTSAndroid.getAppContext()
  if (context == null) { handle('{"event":"error","code":"NO_CONTEXT","message":"App context is unavailable"}'); return }
  HelloFaceVerifyNative.invoke(context, 'enrollFace', JSON.stringify(params), handle)
}

export const verifyFace: VerifyFace = function (options: VerifyFaceOptions) {
  const params = { faceID: options.faceID.trim() } as UTSJSONObject
  params['threshold'] = options.threshold ?? 0.80
  params['silentLiveness'] = options.silentLiveness ?? true
  params['actions'] = options.actions ?? [] as string[]
  params['actionTimeoutMs'] = options.actionTimeoutMs ?? 10000
  params['faceTimeoutMs'] = options.faceTimeoutMs ?? 15000
  params['camera'] = options.camera ?? 'front'
  const handle = (raw: string): void => {
    deliver(raw, 'verifyFace', params.getString('faceID') ?? '', options.success ?? null, options.fail ?? null, options.complete ?? null, options.onProgress ?? null)
  }
  const error = validateParams('verifyFace', params)
  if (error != null) { handle(error); return }
  const context = UTSAndroid.getAppContext()
  if (context == null) { handle('{"event":"error","code":"NO_CONTEXT","message":"App context is unavailable"}'); return }
  HelloFaceVerifyNative.invoke(context, 'verifyFace', JSON.stringify(params), handle)
}

