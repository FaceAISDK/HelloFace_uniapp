import { FaceResult, FaceProgress, FaceSuccess, FaceFailure, FaceComplete, FaceProgressCallback, EnrollFaceOptions, VerifyFaceOptions, SetFaceFeatureOptions, SyncFaceImageOptions, DetectLivenessOptions, ExtractFaceFeatureOptions } from './interface.uts'
import { HelloFaceVerifyFailImpl } from './unierror.uts'
import { resultCode, failureCode, statusMessage, legacyErrorCode } from './status.uts'

// 三端入口只选择原生适配器；默认值、参数校验和回调收尾统一在这里维护。
export function createFaceParams(faceID: string): UTSJSONObject {
  return { faceID: typeof faceID == 'string' ? faceID.trim() : '' } as UTSJSONObject
}
export function createEnrollParams(options: EnrollFaceOptions): UTSJSONObject {
  const params = createFaceParams(options.faceID)
  params['overwrite'] = options.overwrite ?? false
  params['camera'] = options.camera ?? 'front'
  return params
}
export function createVerifyParams(options: VerifyFaceOptions): UTSJSONObject {
  const params = createFaceParams(options.faceID)
  params['threshold'] = options.threshold ?? 0.80
  params['silentLiveness'] = options.silentLiveness ?? true
  params['actions'] = options.actions ?? [] as string[]
  params['actionTimeoutMs'] = options.actionTimeoutMs ?? 3000
  params['faceTimeoutMs'] = options.faceTimeoutMs ?? 15000
  params['camera'] = options.camera ?? 'front'
  if (options.referenceFeature != null) params['referenceFeature'] = options.referenceFeature
  if (options.featureSpaceID != null) params['featureSpaceID'] = options.featureSpaceID
  return params
}
export function createLivenessParams(options: DetectLivenessOptions): UTSJSONObject {
  const params = createFaceParams('')
  params['actions'] = options.actions ?? [] as string[]
  params['actionTimeoutMs'] = options.actionTimeoutMs ?? 3000
  params['faceTimeoutMs'] = options.faceTimeoutMs ?? 15000
  params['camera'] = options.camera ?? 'front'
  return params
}
export function createExtractParams(options: ExtractFaceFeatureOptions): UTSJSONObject {
  return { faceID: '', imageBase64: normalizedImage(options.imageBase64) } as UTSJSONObject
}
function normalizedImage(value: string): string {
  const image = typeof value == 'string' ? value : ''
  if (image.startsWith('data:image/png;base64,')) return image.substring(22)
  if (image.startsWith('data:image/jpeg;base64,')) return image.substring(23)
  return image
}
export function createFeatureParams(options: SetFaceFeatureOptions): UTSJSONObject {
  const params = createFaceParams(options.faceID)
  params['feature'] = options.feature
  params['featureSpaceID'] = options.featureSpaceID
  params['overwrite'] = options.overwrite ?? false
  return params
}
export function createImageParams(options: SyncFaceImageOptions): UTSJSONObject {
  const params = createFaceParams(options.faceID)
  params['imageBase64'] = normalizedImage(options.imageBase64)
  params['overwrite'] = options.overwrite ?? false
  return params
}
function invalidArgument(message: string): string {
  return JSON.stringify({ event: 'error', code: 'INVALID_ARGUMENT', message: message }) ?? ''
}
function validateFeature(feature: string | null, space: string | null): string | null {
  if (feature == null || !/^HF1:[A-Za-z0-9_-]{600}$/.test(feature)) return 'feature must be a complete 604-character HF1 value'
  if (space != 'jdx-feature-v1') return 'featureSpaceID must be jdx-feature-v1; use the value returned with the feature'
  return null
}
export function validateParams(method: string, params: UTSJSONObject): string | null {
  const faceID = params.getString('faceID') ?? ''
  if (method != 'cancel' && method != 'detectLiveness' && method != 'extractFaceFeature' && (faceID.length == 0 || faceID.length > 64 || faceID.indexOf('\u0000') >= 0)) {
    return invalidArgument('faceID must contain 1..64 UTF-16 units without NUL after trimming')
  }
  if (method == 'enrollFace' || method == 'setFaceFeature' || method == 'syncFaceFeature' || method == 'syncFaceImage') {
    if (params.getBoolean('overwrite') == null) return invalidArgument('overwrite must be a boolean')
  }
  if (method == 'enrollFace' || method == 'verifyFace' || method == 'detectLiveness') {
    const camera = params.getString('camera') ?? ''
    if (camera != 'front' && camera != 'back') return invalidArgument('camera must be front or back')
  }
  if (method == 'verifyFace' || method == 'detectLiveness') {
    const threshold = params.getNumber('threshold') ?? -1
    const actionTimeout = params.getNumber('actionTimeoutMs') ?? -1
    const faceTimeout = params.getNumber('faceTimeoutMs') ?? -1
    if (method == 'verifyFace' && (!Number.isFinite(threshold) || threshold < 0 || threshold > 1)) return invalidArgument('threshold must be within 0..1')
    if (method == 'verifyFace' && params.getBoolean('silentLiveness') == null) return invalidArgument('silentLiveness must be a boolean')
    if (!Number.isInteger(actionTimeout) || actionTimeout < 2000 || actionTimeout > 30000) return invalidArgument('actionTimeoutMs must be an integer within 2000..30000')
    if (!Number.isInteger(faceTimeout) || faceTimeout < 1000 || faceTimeout > 60000) return invalidArgument('faceTimeoutMs must be an integer within 1000..60000')
    const actions = params.getArray<string>('actions')
    if (actions == null || actions.length > 4) return invalidArgument('actions must be an array containing at most four actions')
    for (let i = 0; i < actions.length; i++) {
      if (!['blink', 'openMouth', 'shakeHead', 'nodHead'].includes(actions[i])) return invalidArgument('actions supports blink, openMouth, shakeHead and nodHead only')
    }
    if (method == 'verifyFace' && (params['referenceFeature'] != null || params['featureSpaceID'] != null)) {
      const error = validateFeature(params.getString('referenceFeature'), params.getString('featureSpaceID'))
      if (error != null) return invalidArgument('referenceFeature and featureSpaceID must be supplied together: ' + error)
    }
  }
  if (method == 'setFaceFeature' || method == 'syncFaceFeature') {
    const error = validateFeature(params.getString('feature'), params.getString('featureSpaceID'))
    if (error != null) return invalidArgument(error)
  }
  if (method == 'syncFaceImage' || method == 'extractFaceFeature') {
    const image = params.getString('imageBase64') ?? ''
    if (image.length == 0 || image.length > 8388608 || image.length % 4 != 0 ||
      !/^[A-Za-z0-9+/]+={0,2}$/.test(image)) return invalidArgument('imageBase64 must be standard Base64 encoding of a PNG/JPEG, at most 6 MiB')
  }
  return null
}

/** 先校验再进入原生层；参数错误也经过同一分发器，保证 fail 后触发 complete。
 * 适配器只负责获取平台上下文并调用原生实现，不参与业务判定。
 */
export function invokeFaceMethod(method: string, params: UTSJSONObject,
  success: FaceSuccess | null, fail: FaceFailure | null, complete: FaceComplete | null,
  onProgress: FaceProgressCallback | null,
  invoke: (method: string, raw: string, callback: (raw: string) => void) => void): void {
  const handle = createDispatcher(method, params.getString('faceID') ?? '', success, fail, complete, onProgress)
  const error = validateParams(method, params)
  if (error != null) { handle(error); return }
  const raw = JSON.stringify(params) ?? ''
  if (raw.length == 0) { handle(''); return }
  invoke(method, raw, handle)
}

function isProgress(event: UTSJSONObject | null): boolean {
  return event?.getString('event') == 'progress' && event?.getString('code') == 'OK' && event?.getJSON('data')?.getString('stage') != null
}
function score(data: UTSJSONObject | null, key: string): number | null {
  const value = data?.getNumber(key)
  return value != null && Number.isFinite(value) ? value : null
}

function validFrame(jpeg: string, width: number, height: number): boolean {
  return Number.isInteger(width) && width >= 1 && width <= 720 &&
    Number.isInteger(height) && height >= 1 && height <= 720 &&
    jpeg.length > 4 && jpeg.length % 4 == 0 && jpeg.startsWith('/9j/') && !/[^A-Za-z0-9+/=]|=[^=]|={3}/.test(jpeg)
}

/** 过程事件可多次到达，终态只分发一次；损坏响应转为 BRIDGE_ERROR，不能当成成功。 */
export function createDispatcher(method: string, faceID: string,
  success: FaceSuccess | null, fail: FaceFailure | null, complete: FaceComplete | null,
  onProgress: FaceProgressCallback | null): (raw: string) => void {
  let ended = false
  const dispatch = (raw: string): void => {
    if (ended) return
    let event: UTSJSONObject | null = null
    try { event = JSON.parseObject(raw) } catch (_) { /* Converted to BRIDGE_ERROR below. */ }
    const data = event?.getJSON('data')
    const recognitionMethod = method == 'verifyFace' || method == 'detectLiveness'
    const cameraMethod = method == 'enrollFace' || recognitionMethod
    if (cameraMethod && isProgress(event)) {
      const stage = data?.getString('stage') ?? ''
      const action = data?.getString('action') ?? null
      const stepNumber = data?.getNumber('stepNumber') ?? 0
      const stepCount = data?.getNumber('stepCount') ?? 0
      const progress: FaceProgress = {
        faceID: faceID, stage: stage, action: action, stepNumber: stepNumber, stepCount: stepCount
      }
      onProgress?.(progress)
      return
    }
    ended = true // 先标记再调用业务回调，防止回调重入或迟到事件再次结束任务。
    let code = event?.getString('code') ?? 'BRIDGE_ERROR'
    const nativePassed = data?.getBoolean('passed') ?? null
    const nativeOutcome = data?.getString('outcome') ?? null
    const feature = data?.getString('feature') ?? null
    const exists = data?.getBoolean('exists') ?? null
    // 通过必须同时来自 SDK 的 PASSED 终态；矛盾的桥接响应不能产生伪通过。
    const validCameraResult = nativePassed != null && nativeOutcome != null && (nativePassed != true || nativeOutcome == 'PASSED')
    const needsFeature = (method == 'enrollFace' && nativePassed == true) || method == 'getFaceFeature' || method == 'setFaceFeature' || method == 'syncFaceFeature' || method == 'syncFaceImage' || method == 'extractFaceFeature'
    const validResult = event?.getString('event') == 'result' && (!cameraMethod || validCameraResult) &&
      (!needsFeature || feature != null) && (method != 'getFaceStatue' || exists != null)
    if (code == 'OK' && !validResult) code = 'BRIDGE_ERROR'
    if (code != 'OK') {
      const status = failureCode(code)
      const msg = statusMessage(status, method)
      const detail = event?.getString('message') ?? ''
      const error = new HelloFaceVerifyFailImpl(legacyErrorCode(code), method + ':fail ' + msg, code, faceID)
      error.code = status
      error.msg = msg
      error.detail = detail.length > 0 ? detail : (code == 'BRIDGE_ERROR' ? 'Invalid native response' : code)
      try { fail?.(error) } finally { complete?.(error) }
      return
    }
    // ArkTS 的可选链还可能产生 undefined；公开字段统一遵循接口中的 null 约定。
    const passed = cameraMethod ? nativePassed : null
    const outcome: string | null = cameraMethod ? nativeOutcome : null
    const resultFeature: string | null = method == 'enrollFace' || needsFeature ? feature : null
    const resultExists = method == 'getFaceStatue' ? (exists ?? false) : null
    const similarity: number | null = method == 'verifyFace' ? score(data ?? null, 'similarity') : null
    const livenessScore: number | null = recognitionMethod ? score(data ?? null, 'livenessScore') : null
    const frameJpeg = recognitionMethod ? (data?.getString('frameJpegBase64') ?? '') : ''
    const width = recognitionMethod ? (data?.getNumber('frameWidth') ?? 0) : 0
    const height = recognitionMethod ? (data?.getNumber('frameHeight') ?? 0) : 0
    const hasFrame = validFrame(frameJpeg, width, height)
    const frameJpegBase64: string | null = hasFrame ? frameJpeg : null
    const frameWidth: number | null = hasFrame ? width : null
    const frameHeight: number | null = hasFrame ? height : null
    const status = cameraMethod ? resultCode(nativePassed ?? false, outcome) : 0
    const result: FaceResult = {
      code: status, msg: statusMessage(status, method),
      errMsg: method + ':ok', faceID: faceID,
      feature: resultFeature,
      featureSpaceID: 'jdx-feature-v1',
      exists: resultExists,
      passed: passed, outcome: outcome,
      similarity: similarity, livenessScore: livenessScore,
      frameJpegBase64: frameJpegBase64, frameWidth: frameWidth, frameHeight: frameHeight
    }
    try { success?.(result) } finally { complete?.(result) }
  }
  return dispatch
}
