import { EnrollFace, VerifyFace, GetFaceFeature, SetFaceFeature, DeleteFace, EnrollFaceOptions, VerifyFaceOptions, FaceIDOptions, SetFaceFeatureOptions, SyncFaceImage, SyncFaceFeature, SyncFaceImageOptions, SyncFaceFeatureOptions, CancelOptions } from '../interface.uts'
import { createDispatcher, validateParams, createFaceParams, createEnrollParams, createVerifyParams, createFeatureParams, createImageParams } from '../shared.uts'

export const enrollFace: EnrollFace = function (options: EnrollFaceOptions) {
  const params = createEnrollParams(options)
  const handle = createDispatcher('enrollFace', params.getString('faceID') ?? '', options.success ?? null, options.fail ?? null, options.complete ?? null, options.onProgress ?? null)
  const error = validateParams('enrollFace', params)
  if (error != null) { handle(error); return }
  HelloFaceVerifyNative.invoke('enrollFace', JSON.stringify(params), handle)
}

