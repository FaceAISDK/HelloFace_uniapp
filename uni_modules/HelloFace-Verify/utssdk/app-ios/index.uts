export function cancel(options: CancelOptions | null = null): void {
  const params = { faceID: '' } as UTSJSONObject
  const handle = createDispatcher('cancel', params.getString('faceID') ?? '', options?.success ?? null, options?.fail ?? null, options?.complete ?? null, null)
  const error = validateParams('cancel', params)
  if (error != null) { handle(error); return }
  HelloFaceVerifyNative.invoke('cancel', JSON.stringify(params), handle)
}
