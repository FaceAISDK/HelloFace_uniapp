import { EnrollFace, VerifyFace, GetFaceFeature, SetFaceFeature, DeleteFace, EnrollFaceOptions, VerifyFaceOptions, FaceIDOptions, SetFaceFeatureOptions, SyncFaceImage, SyncFaceFeature, SyncFaceImageOptions, SyncFaceFeatureOptions, CancelOptions } from '../interface.uts'
import { invokeFaceMethod, createFaceParams, createEnrollParams, createVerifyParams, createFeatureParams, createImageParams } from '../shared.uts'

// 平台适配边界：公共参数与回调语义由 shared.uts 处理。
const invokeNative = function (method: string, raw: string, callback: (raw: string) => void): void {
  HelloFaceVerifyNative.invoke(method, raw, callback)
}

export const enrollFace: EnrollFace = function (options: EnrollFaceOptions) {
  invokeFaceMethod('enrollFace', createEnrollParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    options.onProgress ?? null, invokeNative)
}

export const verifyFace: VerifyFace = function (options: VerifyFaceOptions) {
  invokeFaceMethod('verifyFace', createVerifyParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    options.onProgress ?? null, invokeNative)
}

export const getFaceFeature: GetFaceFeature = function (options: FaceIDOptions) {
  invokeFaceMethod('getFaceFeature', createFaceParams(options.faceID),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    null, invokeNative)
}

export const setFaceFeature: SetFaceFeature = function (options: SetFaceFeatureOptions) {
  invokeFaceMethod('setFaceFeature', createFeatureParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    null, invokeNative)
}

export const syncFaceFeature: SyncFaceFeature = function (options: SyncFaceFeatureOptions) {
  invokeFaceMethod('syncFaceFeature', createFeatureParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    null, invokeNative)
}

export const syncFaceImage: SyncFaceImage = function (options: SyncFaceImageOptions) {
  invokeFaceMethod('syncFaceImage', createImageParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    null, invokeNative)
}

export const deleteFace: DeleteFace = function (options: FaceIDOptions) {
  invokeFaceMethod('deleteFace', createFaceParams(options.faceID),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    null, invokeNative)
}

export function cancel(options: CancelOptions | null = null): void {
  invokeFaceMethod('cancel', createFaceParams(''),
    options?.success ?? null, options?.fail ?? null, options?.complete ?? null, null, invokeNative)
}
