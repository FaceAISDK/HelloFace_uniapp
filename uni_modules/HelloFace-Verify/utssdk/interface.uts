/** 相机方向。front：前置（默认）；back：后置。 */
export type FaceCamera = 'front' | 'back'
/** 动作按数组顺序执行；最多 4 步，可重复。 */
export type FaceAction = 'blink' | 'openMouth' | 'shakeHead' | 'nodHead'

/** 0 成功；1xx 操作问题；2xx 识别未通过；3xx 运行异常。 */
export type FaceCode = 0 | 101 | 102 | 103 | 104 | 105 | 106 | 107 | 108 | 109 |
  201 | 202 | 203 | 204 | 205 | 206 | 207 | 299 |
  301 | 302 | 303 | 304 | 305 | 306 | 307 | 308

/** success 表示调用正常完成；验证是否通过必须判断 passed === true。 */
export type FaceResult = {
  /** 简短返回码；识别未通过为 2xx，仍走 success，并返回 passed: false。 */
  code: FaceCode,
  /** 可直接展示的短提示，如“录入成功”“未检测到人脸”。 */
  msg: string,
  /** 如 verifyFace:ok，不代表身份验证通过。 */
  errMsg: string,
  /** 去除两端空白后的业务用户标识；cancel/独立活体/图片提取返回空串。 */
  faceID: string,
  /** 录入、读取、同步、图片提取返回 HF1；验证/活体/状态查询不返回特征。不要写入日志。 */
  feature: string | null,
  /** 同步特征时连同 feature 一起传递，禁止混用其他模型特征。 */
  featureSpaceID: string,
  /** 仅 getFaceStatue 返回：true 表示基准存在且可读取；其他方法为 null。异常走 fail，不伪装成 false。 */
  exists?: boolean | null,
  /** 录入/验证/独立活体的 SDK 判定；特征管理、取消为 null。 */
  passed: boolean | null,
  /** PASSED、NOT_MATCHED、SPOOF_DETECTED、NO_FACE_TIMEOUT 等；未产生时为 null。 */
  outcome: string | null,
  /** 仅验证返回 SDK 相似度，其他接口或未产生时为 null；不是身份概率。 */
  similarity: number | null,
  /** 验证/独立活体返回 SDK 活体分数，未产生时为 null；不得用分数覆盖 passed。 */
  livenessScore: number | null
}
/** 可选过程通知；不是终态，不会触发 complete。原生页面已提供操作引导。 */
export type FaceProgress = {
  faceID: string,
  /** WAITING_FOR_FACE、PERFORM_ACTION 等 SDK 阶段名称。 */
  stage: string,
  /** blink / openMouth / shakeHead / nodHead；当前无动作时为 null。 */
  action: string | null,
  /** SDK 返回的当前步骤编号；非动作阶段通常为 0。 */
  stepNumber: number,
  stepCount: number
}
export type HelloFaceVerifyErrorCode = 9011001 | 9011002 | 9011003 | 9011004 | 9011005 | 9011006 | 9011007 | 9011008
/** 接口错误；业务拒绝走 success(passed: false)，用户取消走 fail(9011003)。 */
export interface HelloFaceVerifyFail extends IUniError {
  /** 简短返回码，日常业务处理优先使用此字段。 */
  code: FaceCode,
  /** 可直接展示的短提示，如“请先录入”“相机未授权”。 */
  msg: string,
  /** 原始参数校验或 SDK 错误说明，仅供排查；不直接用于用户提示。 */
  detail: string,
  /** 保留原有 UniError 返回码，兼容已有接入。 */
  errCode: HelloFaceVerifyErrorCode,
  /** 原始 SDK/桥接错误名，如 CANCELLED、NOT_FOUND；便于定位问题。 */
  sdkCode: string,
  /** 此次调用的业务标识，参数无效或 cancel 时可为空。 */
  faceID: string
}
export type FaceSuccess = (result: FaceResult) => void
export type FaceFailure = (error: HelloFaceVerifyFail) => void
/** 仅用于收尾。按官方 JS 桥接约定使用 any，业务字段在 success/fail 中读取。 */
export type FaceComplete = (result: any) => void
export type FaceProgressCallback = (progress: FaceProgress) => void

/** 录入只需 faceID；相机权限在调用后申请，用户确认前不会保存或覆盖基准。 */
export type EnrollFaceOptions = {
  /** 必填。1..64 个 UTF-16 单元；两端空白自动去除，不允许 NUL。 */
  faceID: string,
  /** 默认 false；已有基准返回 9011006。true 时仍需用户确认保存。 */
  overwrite?: boolean,
  /** 默认 front。不支持请求的相机时 fail，不自动切换方向。 */
  camera?: FaceCamera,
  onProgress?: FaceProgressCallback,
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}

/** 默认以 faceID 读取本机基准；也可同时传 referenceFeature、featureSpaceID 仅用于本次验证。 */
export type VerifyFaceOptions = {
  /** 必填业务标识。本机验证时应与录入相同；直接传基准时用于关联回调。 */
  faceID: string,
  /** 可选的完整 HF1 基准；提供后优先使用，不读取/写入本机基准。必须配合 featureSpaceID。 */
  referenceFeature?: string,
  /** 必须来自同版本 getFaceFeature/enrollFace 的结果，不要猜测或省略。 */
  featureSpaceID?: string,
  /** 默认 0.80，范围 0..1；调低会放宽比对要求。 */
  threshold?: number,
  /** 默认 true。false 仅关闭静默活体，不会清除 actions。 */
  silentLiveness?: boolean,
  /** 默认 []。启用动作直接传 ['blink', 'nodHead']；不会自动关闭静默活体。 */
  actions?: FaceAction[],
  /** 每步动作的超时，整数毫秒 2000..30000；默认 3000。不是整个流程总时长。 */
  actionTimeoutMs?: number,
  /** 等待首次人脸的超时，整数毫秒 1000..60000；默认 15000。仅作用于验证。 */
  faceTimeoutMs?: number,
  /** 默认 front。 */
  camera?: FaceCamera,
  onProgress?: FaceProgressCallback,
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}

/** 独立活体，无需 faceID 或基准，不比对身份、不保存照片/特征。
 * SDK 始终执行静默活体；actions 非空时追加动作挑战。结果必须检查 passed。
 */
export type DetectLivenessOptions = {
  /** 默认 []，仅静默；可传 ['blink', 'nodHead'] 叠加动作，最多 4 步。 */
  actions?: FaceAction[],
  /** 默认 3000；每步动作超时，2000..30000 整数毫秒。 */
  actionTimeoutMs?: number,
  /** 默认 15000；首次人脸等待超时，1000..60000 整数毫秒。 */
  faceTimeoutMs?: number,
  camera?: FaceCamera,
  onProgress?: FaceProgressCallback,
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}

/** PNG/JPEG → HF1；只提取，不读写任何本机基准，也不执行活体。图片限制同 syncFaceImage。 */
export type ExtractFaceFeatureOptions = {
  imageBase64: string,
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}

/** 指定用户的本机基准操作；不启动相机、不申请相机权限。 */
export type FaceIDOptions = {
  faceID: string,
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}

/** 将已有基准保存到本机；feature 与 featureSpaceID 应成对从录入/读取结果取得。 */
export type SetFaceFeatureOptions = {
  faceID: string,
  /** 完整 HF1 特征，禁止截断或改用图片/base64。 */
  feature: string,
  featureSpaceID: string,
  /** 默认 false，true 时覆盖指定用户的基准。本接口无确认页面，由业务确认。 */
  overwrite?: boolean,
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}

/** 从外部 PNG/JPEG 提取特征并保存本机基准。不打开相机，不执行活体检测。 */
export type SyncFaceImageOptions = {
  faceID: string,
  /** 标准 Base64，可带 data:image/png;base64, 或 data:image/jpeg;base64, 前缀。
   * 编码文件最多 6 MiB；每边 2..4096 px，总像素不超过 4194304。
   * 请传清晰单人照片；SDK 选择最大脸，人脸宽高须至少 100 px。支持 EXIF 方向。
   */
  imageBase64: string,
  /** 默认 false。覆盖由业务确认；原图不持久化，仅保存提取的特征。 */
  overwrite?: boolean,
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}
/** 同 setFaceFeature，便于表达服务端/其他设备下发基准的同步场景。 */
export type SyncFaceFeatureOptions = SetFaceFeatureOptions

export type CancelOptions = {
  success?: FaceSuccess,
  fail?: FaceFailure,
  complete?: FaceComplete
}

/** 打开相机录入，并在用户确认后加密保存。示例：enrollFace({ faceID: 'user-1' })。 */
export type EnrollFace = (options: EnrollFaceOptions) => void
/** 1:1 验证。最简调用：verifyFace({ faceID: 'user-1', success: (res) => { ... } })。 */
export type VerifyFace = (options: VerifyFaceOptions) => void
/** 读取基准供业务同步；不存在返回 9011005。 */
export type GetFaceFeature = (options: FaceIDOptions) => void
/** 保存相同模型的基准；不打开相机。 */
export type SetFaceFeature = (options: SetFaceFeatureOptions) => void
/** 删除指定用户的本机基准；不存在也成功，正在识别时返回 BUSY。 */
export type DeleteFace = (options: FaceIDOptions) => void
/** cancel() 即可取消当前相机任务；原任务 fail(CANCELLED)，本调用 success。无任务也成功；保存提交中返回 BUSY。 */
export type Cancel = (options?: CancelOptions) => void

/** 外部图片 → SDK extractFeature → 本机基准；成功仅代表同步，不代表验证通过。 */
export type SyncFaceImage = (options: SyncFaceImageOptions) => void
/** 将同模型的外部 HF1 基准保存到本机，无需重新录入。 */
export type SyncFaceFeature = (options: SyncFaceFeatureOptions) => void

/** 独立相机活体；可用 cancel() 取消，passed 为 SDK 真实活体结论，faceID 返回空串。 */
export type DetectLiveness = (options: DetectLivenessOptions) => void
/** 只提取并返回 feature / featureSpaceID；不持久化，faceID 返回空串。 */
export type ExtractFaceFeature = (options: ExtractFaceFeatureOptions) => void
/** 只读查询，不返回特征；缺少基准 success(exists: false)，读取异常 fail。名称沿用 getFaceStatue。 */
export type GetFaceStatue = (options: FaceIDOptions) => void
