import { EnrollFace, VerifyFace, GetFaceFeature, SetFaceFeature, DeleteFace, EnrollFaceOptions, VerifyFaceOptions, FaceIDOptions, SetFaceFeatureOptions, SyncFaceImage, SyncFaceFeature, SyncFaceImageOptions, SyncFaceFeatureOptions, CancelOptions, DetectLiveness, DetectLivenessOptions, ExtractFaceFeature, ExtractFaceFeatureOptions, GetFaceStatue } from '../interface.uts'
import { invokeFaceMethod, createFaceParams, createEnrollParams, createVerifyParams, createFeatureParams, createImageParams, createLivenessParams, createExtractParams } from '../shared.uts'
import { HelloFaceVerifyNative } from 'uts.sdk.modules.HelloFaceVerify'

// 平台适配边界：公共参数与回调语义由 shared.uts 处理。
const invokeNative = function (method: string, raw: string, callback: (raw: string) => void): void {
  const context = UTSAndroid.getAppContext()
  if (context == null) { callback('{"event":"error","code":"NO_CONTEXT","message":"App context is unavailable"}'); return }
  HelloFaceVerifyNative.invoke(context, method, raw, callback)
}

export const enrollFace: EnrollFace = function (options: EnrollFaceOptions) {
  invokeFaceMethod('enrollFace', createEnrollParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    options.onProgress ?? null, invokeNative)
}

export const verifyFace: VerifyFace = function (options: VerifyFaceOptions) {
  invokeFaceMethod('verifyFace', createVerifyParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    options.onProgress ?? null, invokeNative)
}

export const getFaceFeature: GetFaceFeature = function (options: FaceIDOptions) {
  invokeFaceMethod('getFaceFeature', createFaceParams(options.faceID),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    null, invokeNative)
}

export const setFaceFeature: SetFaceFeature = function (options: SetFaceFeatureOptions) {
  invokeFaceMethod('setFaceFeature', createFeatureParams(options),
    options.success ?? null, options.fail ?? null, options.complete ?? null,
    null, invokeNative)
}

