import { EnrollFace, VerifyFace, GetFaceFeature, SetFaceFeature, DeleteFace, EnrollFaceOptions, VerifyFaceOptions, FaceIDOptions, SetFaceFeatureOptions, CancelOptions } from '../interface.uts'
import { createDispatcher, validateParams, createFaceParams, createEnrollParams, createVerifyParams, createFeatureParams } from '../shared.uts'
import { HelloFaceVerifyNative } from 'uts.sdk.modules.HelloFaceVerify'

export const enrollFace: EnrollFace = function (options: EnrollFaceOptions) {
  const params = createEnrollParams(options)
  const handle = createDispatcher('enrollFace', params.getString('faceID') ?? '', options.success ?? null, options.fail ?? null, options.complete ?? null, options.onProgress ?? null)
  const error = validateParams('enrollFace', params)
  if (error != null) { handle(error); return }
  const context = UTSAndroid.getAppContext()
  if (context == null) { handle('{"event":"error","code":"NO_CONTEXT","message":"App context is unavailable"}'); return }
  HelloFaceVerifyNative.invoke(context, 'enrollFace', JSON.stringify(params), handle)
}

