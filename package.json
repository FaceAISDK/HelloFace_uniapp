{
  "name": "hellofaceverify-uniapp",
  "version": "0.1.2",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "sdk:install": "python3 scripts/install_sdk.py",
    "sdk:check": "python3 scripts/install_sdk.py --check",
    "demo:prepare": "python3 scripts/prepare_example.py",
    "android:check": "python3 scripts/run_android.py --check",
    "android:prepare": "python3 scripts/android_debug.py prepare",
    "android:base": "python3 scripts/build_android_base.py",
    "android:devices": "python3 scripts/android_debug.py devices",
    "android:dev": "python3 scripts/dev_android.py",
    "android:logs": "python3 scripts/android_debug.py logs",
    "android:alignment": "python3 scripts/check_android_alignment.py",
    "android:run": "python3 scripts/run_android.py",
    "android:native-check": "python3 scripts/check_android_native.py",
    "test": "node --test tests/*.test.cjs && python3 -m unittest discover -s tests -v",
    "uts:check": "node scripts/check_uts.cjs",
    "check": "npm test && npm run sdk:check && npm run uts:check",
    "android:uts-check": "node scripts/check_android_uts.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
