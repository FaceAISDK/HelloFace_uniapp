{
  "name": "hellofaceverify-uniapp",
  "version": "0.1.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "sdk:install": "python3 scripts/install_sdk.py",
    "sdk:check": "python3 scripts/install_sdk.py --check",
    "demo:prepare": "python3 scripts/prepare_example.py",
    "android:check": "python3 scripts/run_android.py --check",
    "android:run": "python3 scripts/run_android.py",
    "test": "node --test tests/*.test.cjs && python3 -m unittest discover -s tests -v",
    "uts:check": "node scripts/check_uts.cjs",
    "check": "npm test && npm run sdk:check && npm run uts:check"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
