{
  "name": "HelloFaceVerify uvue Demo",
  "appid": "__UNI__HELLOFACE",
  "description": "HelloFaceVerify 离线人脸识别与 1:1 人脸比对 UTS 示例",
  "versionName": "0.1.3",
  "versionCode": "103",
  "app-harmony": {
    "distribute": {
      "bundleName": "dev.helloface.uniapp.demo"
    }
  },
  "uni-app-x": {},
  "app-android": {
    "distribute": {
      "minSdkVersion": 23,
      "abiFilters": [
        "arm64-v8a",
        "armeabi-v7a"
      ],
      "aaptOptions": [
        "noCompress 'bphfm'"
      ],
      "packagename": "dev.helloface.uniappx.demo"
    }
  },
  "app-ios": {
    "distribute": {
      "deploymentTarget": "15.0"
    }
  },
  "uniStatistics": {
    "enable": false
  }
}
