{
  "name": "HelloFaceVerify uvue Demo",
  "appid": "__UNI__HELLOFACE",
  "description": "HelloFaceVerify 离线人脸识别与 1:1 人脸比对 UTS 示例",
  "versionName": "0.2.0",
  "versionCode": "200",
  "app-harmony": {
    "distribute": {
      "bundleName": "dev.helloface.uniapp.demo",
      "compatibleSdkVersion": "6.0.0(20)",
      "icons": {
        "foreground": "app-icons/harmony/foreground.png",
        "background": "app-icons/harmony/background.png"
      }
    }
  },
  "uni-app-x": {},
  "app-android": {
    "distribute": {
      "minSdkVersion": 23,
      "enableResourceOptimizations": true,
      "abiFilters": [
        "arm64-v8a",
        "armeabi-v7a"
      ],
      "aaptOptions": [
        "noCompress 'bphfm'"
      ],
      "packagename": "dev.helloface.uniappx.demo",
      "icons": {
        "hdpi": "app-icons/android/hdpi.png",
        "xhdpi": "app-icons/android/xhdpi.png",
        "xxhdpi": "app-icons/android/xxhdpi.png",
        "xxxhdpi": "app-icons/android/xxxhdpi.png"
      }
    }
  },
  "app-ios": {
    "distribute": {
      "deploymentTarget": "15.0",
      "icons": {
        "appstore": "app-icons/HiFaceUni.png"
      }
    }
  },
  "uniStatistics": {
    "enable": false
  }
}
